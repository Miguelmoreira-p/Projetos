# Copie este arquivo para ".env" e ajuste os valores.
# Para APENAS testar a detecção (dev_preview.py / simulate.py --no-persist),
# você não precisa preencher nada do Supabase abaixo — os valores padrão em
# app/config.py já bastam.

# --- Supabase (necessário só quando for persistir eventos de verdade) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_MEDIA_BUCKET=event-clips

# --- CORS (frontend local) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Visão computacional ---
MODEL_PATH=yolov8n.pt
MIN_CONFIDENCE=0.40
MIN_DETECTION_FRAMES=8
WINDOW_SECONDS=3
COOLDOWN_SECONDS=30

# --- Buffer / clipe ---
BUFFER_SECONDS=5
POST_EVENT_SECONDS=5
RETENTION_DAYS=7

# --- Simulação ---
SIMULATION_MODE=true

# --- Pose (contexto corporal complementar ao detector de celular) ---
# Desabilitado por padrão. Quando true, só entra em ação DEPOIS que o
# celular já foi detectado com confiança suficiente — nunca cria evento
# sozinho. Ver app/vision/pose.py para a justificativa dessa restrição.
POSE_ENABLED=true
POSE_MODEL_PATH=yolov8n-pose.pt
POSE_MIN_KEYPOINT_CONFIDENCE=0.5
POSE_HAND_PROXIMITY_RATIO=0.6
POSE_HEAD_DOWN_RATIO=0.12
POSE_WRITING_HANDS_TOGETHER_RATIO=0.5

# Pesos do sistema de pontuação de suspeita (soma heurística, não é uma
# probabilidade calibrada; serve só para priorizar a fila de revisão humana).
WEIGHT_PHONE_VISUAL=0.55
WEIGHT_HAND_PROXIMITY=0.20
WEIGHT_HEAD_DOWN=0.10
WEIGHT_HANDS_HIDDEN=0.10
WEIGHT_PERSISTENCE=0.10
WEIGHT_WRITING_REDUCTION=0.25
